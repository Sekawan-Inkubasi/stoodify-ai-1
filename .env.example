# Salin file ini menjadi ".env" lalu isi nilainya. Jangan commit file .env.

# --- LLM (API apa pun yang OpenAI-compatible) ---
# Isi dengan token, base URL, dan nama model dari penyedia kamu.
LLM_API_KEY=isi_token_di_sini
# Alamat API tanpa "/chat/completions". Contoh:
#   OpenAI      https://api.openai.com/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
# Boleh beberapa model dipisah koma; berikutnya dipakai jika yang pertama sibuk (503/429).
LLM_MODEL=gpt-4o-mini

# --- Service untuk backend ---
# Rahasia bersama dengan backend Go: nilainya HARUS sama dengan AI_API_KEY di .env backend.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_API_KEY=isi_rahasia_bersama_di_sini
# Batas total menunggu LLM (detik). Backend menunggu 15 detik, jadi biarkan 10.
AI_TIMEOUT_SECONDS=10
# Hanya untuk percobaan lokal tanpa AI_API_KEY. JANGAN diaktifkan di server publik.
# ALLOW_NO_AUTH=true
